{
  "name": "premiere-video-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Durable single-node control plane for autonomous Premiere production",
  "scripts": {
    "factory": "node cli.js",
    "serve": "node cli.js serve",
    "stack:start": "bash scripts/start-premiere-stack.sh",
    "stack:stop": "bash scripts/stop-premiere-stack.sh",
    "uxp:load-ui": "node scripts/uxp-load-premiere-plugin.js",
    "test": "node --test tests/*.test.js"
  }
}
